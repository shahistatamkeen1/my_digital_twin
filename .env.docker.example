# Copy to .env.docker and replace every CHANGE_ME value.
# Start with:
# docker compose --env-file .env.docker up --build -d

APP_VERSION=0.5.1

POSTGRES_DB=my_digital_twin
POSTGRES_USER=mdt_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_URL_SAFE_PASSWORD
BACKEND_DATABASE_URL=postgresql+psycopg2://mdt_app:CHANGE_ME_USE_A_LONG_URL_SAFE_PASSWORD@database:5432/my_digital_twin

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_CHARACTERS

BACKEND_PORT=8000
FRONTEND_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_USE_VERSIONED_ROUTES=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_BASE_URL=http://localhost:8000

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_LEGACY_API_ROUTES=true
API_DOCS_ENABLED=true
READINESS_REQUIRE_AUTH=true
READINESS_REQUIRE_AI=false

CONTAINER_RUN_MIGRATIONS=true
CONTAINER_DB_WAIT_TIMEOUT_SECONDS=60
CONTAINER_DB_WAIT_INTERVAL_SECONDS=2
