APP_NAME=My Digital Twin API
APP_VERSION=0.5.4
ENVIRONMENT=development


# Phase 5B container startup controls
CONTAINER_RUN_MIGRATIONS=true
CONTAINER_DB_WAIT_TIMEOUT_SECONDS=60
CONTAINER_DB_WAIT_INTERVAL_SECONDS=2

# Phase 4A API reliability and request tracing
LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID
EXPOSE_INTERNAL_ERROR_DETAILS=false

# Phase 4B API versioning
API_CURRENT_VERSION=v1
API_V1_PREFIX=/api/v1
API_VERSION_HEADER=X-API-Version
ENABLE_LEGACY_API_ROUTES=true
LEGACY_API_SUNSET=Fri, 31 Dec 2027 23:59:59 GMT

# Phase 4C collection pagination
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=100

# Phase 4D production monitoring and readiness policy
MONITORING_CACHE_TTL_SECONDS=5
MONITORING_DISK_WARNING_PERCENT=90
MONITORING_DISK_CRITICAL_PERCENT=98
MONITORING_MEMORY_WARNING_PERCENT=90
MONITORING_INCLUDE_PROCESS_METRICS=true
READINESS_REQUIRE_AUTH=true
READINESS_REQUIRE_AI=false

# Phase 4E OpenAPI documentation and contract export
API_DOCS_ENABLED=true
API_OPENAPI_PATH=/api/v1/openapi.json
API_DOCS_PATH=/api/v1/docs
API_REDOC_PATH=/api/v1/redoc
# Set this to the public deployment URL in production, for example:
# PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_API_BASE_URL=
OPENAPI_CONTACT_NAME=My Digital Twin Engineering
OPENAPI_CONTACT_EMAIL=
OPENAPI_LICENSE_NAME=Proprietary

# Development fallback:
DATABASE_URL=sqlite:///./my_digital_twin.db
# PostgreSQL example after Phase 3B:
# DATABASE_URL=postgresql+psycopg2://mdt_app:URL_ENCODED_PASSWORD@127.0.0.1:5432/my_digital_twin
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Phase 3 uses Alembic. Keep this false.
AUTO_CREATE_TABLES=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ACCESS_COOKIE_NAME=mdt_access_token
REFRESH_COOKIE_NAME=mdt_refresh_token
REFRESH_COOKIE_PATH=/api
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
