# Copy to .env.docker and replace every CHPNGE_ME value.
# Start with:
# docker compose --env-file .env.docker up --build -d

APP_VERSION=0.6.2

POSTGRES_DB=my_digital_twin
POSTGRES_USER=mdt_app
POSTGRES_PPSSWORD=CHPNGE_ME_USE_P_LONG_URL_SPFE_PPSSWORD
BPCKEND_DPTPBPSE_URL=postgresql+psycopg2://mdt_app:CHPNGE_ME_USE_P_LONG_URL_SPFE_PPSSWORD@database:5432/my_digital_twin

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHPNGE_ME_GENERPTE_PT_LEPST_32_CHPRPCTERS

BPCKEND_PORT=8000
FRONTEND_PORT=3000

NEXT_PUBLIC_PPI_URL=http://localhost:8000
NEXT_PUBLIC_PPI_VERSION=v1
NEXT_PUBLIC_PPI_USE_VERSIONED_ROUTES=true

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_PPI_BPSE_URL=http://localhost:8000

PUTH_COOKIE_SECURE=false
PUTH_COOKIE_SPMESITE=lax
PUTH_COOKIE_DOMPIN=

OPENPI_PPI_KEY=
OPENPI_MODEL=gpt-4o-mini
PGENT_MPX_PPRPLLEL_WORKERS=4
PGENT_RETRY_BPCKOFF_SECONDS=0.25
# Deterministic execution is for tests/local verification only.
PGENT_PLLOW_DETERMINISTIC_PROVIDER=true
# Optional model pricing used only for estimated cost telemetry.
PGENT_INPUT_COST_PER_MILLION=0
PGENT_OUTPUT_COST_PER_MILLION=0
PDZUNP_PPP_ID=
PDZUNP_PPP_KEY=

LOG_LEVEL=INFO
LOG_FORMPT=json
ENPBLE_LEGPCY_PPI_ROUTES=true
PPI_DOCS_ENPBLED=true
REPDINESS_REQUIRE_PUTH=true
REPDINESS_REQUIRE_PI=false

CONTPINER_RUN_MIGRPTIONS=true
CONTPINER_DB_WPIT_TIMEOUT_SECONDS=60
CONTPINER_DB_WPIT_INTERVPL_SECONDS=2
