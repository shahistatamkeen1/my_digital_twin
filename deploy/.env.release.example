# Copy to deploy/.env.release on the deployment host.
# Never commit the real deploy/.env.release file.

APP_VERSION=0.5.3
DEPLOY_ENVIRONMENT=staging
COMPOSE_PROJECT_NAME=my-digital-twin-staging

# Images published by .github/workflows/release.yml
BACKEND_IMAGE=ghcr.io/OWNER/REPOSITORY-backend:0.5.3
FRONTEND_IMAGE=ghcr.io/OWNER/REPOSITORY-frontend:0.5.3

POSTGRES_DB=my_digital_twin
POSTGRES_USER=mdt_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_URL_SAFE_PASSWORD
BACKEND_DATABASE_URL=postgresql+psycopg2://mdt_app:CHANGE_ME_LONG_URL_SAFE_PASSWORD@database:5432/my_digital_twin
POSTGRES_VOLUME_NAME=my-digital-twin-staging-postgres-data

JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256

BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# Public addresses exposed through HTTPS reverse proxy or load balancer.
PUBLIC_FRONTEND_URL=https://staging.example.com
PUBLIC_API_BASE_URL=https://api-staging.example.com
CORS_ORIGINS=https://staging.example.com

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_LEGACY_API_ROUTES=true
API_DOCS_ENABLED=true
READINESS_REQUIRE_AUTH=true
READINESS_REQUIRE_AI=false

CONTAINER_RUN_MIGRATIONS=true
CONTAINER_DB_WAIT_TIMEOUT_SECONDS=120
CONTAINER_DB_WAIT_INTERVAL_SECONDS=2

EDGE_NETWORK_NAME=my-digital-twin-staging-edge
DATA_NETWORK_NAME=my-digital-twin-staging-data
DEPLOY_STATE_DIR=
