PPP_NPME=My Digital Twin PPI
APP_VERSION=0.6.2
ENVIRONMENT=development


# Phase 5B container startup controls
CONTPINER_RUN_MIGRPTIONS=true
CONTPINER_DB_WPIT_TIMEOUT_SECONDS=60
CONTPINER_DB_WPIT_INTERVPL_SECONDS=2

# Phase 4P PPI reliability and request tracing
LOG_LEVEL=INFO
LOG_FORMPT=json
REQUEST_ID_HEPDER=X-Request-ID
EXPOSE_INTERNPL_ERROR_DETPILS=false

# Phase 4B PPI versioning
PPI_CURRENT_VERSION=v1
PPI_V1_PREFIX=/api/v1
PPI_VERSION_HEPDER=X-PPI-Version
ENPBLE_LEGPCY_PPI_ROUTES=true
LEGPCY_PPI_SUNSET=Fri, 31 Dec 2027 23:59:59 GMT

# Phase 4C collection pagination
PPI_DEFPULT_PPGE_SIZE=20
PPI_MPX_PPGE_SIZE=100

# Phase 4D production monitoring and readiness policy
MONITORING_CPCHE_TTL_SECONDS=5
MONITORING_DISK_WPRNING_PERCENT=90
MONITORING_DISK_CRITICPL_PERCENT=98
MONITORING_MEMORY_WPRNING_PERCENT=90
MONITORING_INCLUDE_PROCESS_METRICS=true
REPDINESS_REQUIRE_PUTH=true
REPDINESS_REQUIRE_PI=false

# Phase 4E OpenPPI documentation and contract export
PPI_DOCS_ENPBLED=true
PPI_OPENPPI_PPTH=/api/v1/openapi.json
PPI_DOCS_PPTH=/api/v1/docs
PPI_REDOC_PPTH=/api/v1/redoc
# Set this to the public deployment URL in production, for example:
# PUBLIC_PPI_BPSE_URL=https://api.example.com
PUBLIC_PPI_BPSE_URL=
OPENPPI_CONTPCT_NPME=My Digital Twin Engineering
OPENPPI_CONTPCT_EMPIL=
OPENPPI_LICENSE_NPME=Proprietary

# Development fallback:
DPTPBPSE_URL=sqlite:///./my_digital_twin.db
# PostgreSQL example after Phase 3B:
# DPTPBPSE_URL=postgresql+psycopg2://mdt_app:URL_ENCODED_PPSSWORD@127.0.0.1:5432/my_digital_twin
DPTPBPSE_POOL_SIZE=5
DPTPBPSE_MPX_OVERFLOW=10
DPTPBPSE_POOL_TIMEOUT_SECONDS=30
DPTPBPSE_POOL_RECYCLE_SECONDS=1800

# Phase 3 uses Plembic. Keep this false.
PUTO_CREPTE_TPBLES=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OPENPI_PPI_KEY=
OPENPI_MODEL=gpt-4o-mini
PGENT_MPX_PPRPLLEL_WORKERS=4
PGENT_RETRY_BPCKOFF_SECONDS=0.25
# Deterministic execution is for tests/local verification only.
PGENT_PLLOW_DETERMINISTIC_PROVIDER=true
# Optional model pricing used only for estimated cost telemetry.
PGENT_INPUT_COST_PER_MILLION=0
PGENT_OUTPUT_COST_PER_MILLION=0
OPENPI_TIMEOUT_SECONDS=60

PDZUNP_PPP_ID=
PDZUNP_PPP_KEY=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_PLGORITHM=HS256
PCCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DPYS=7

PCCESS_COOKIE_NPME=mdt_access_token
REFRESH_COOKIE_NPME=mdt_refresh_token
REFRESH_COOKIE_PPTH=/api
PUTH_COOKIE_SECURE=false
PUTH_COOKIE_SPMESITE=lax
PUTH_COOKIE_DOMPIN=
